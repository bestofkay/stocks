# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_NAME=Portfolio Aggregator

# Database (MySQL 8+)
DATABASE_URL=mysql+pymysql://portfolio_user:change_me@127.0.0.1:3306/portfolio

# Secrets — generate with: python scripts/generate_keys.py
# APP_ENCRYPTION_KEY: 32-byte key, base64-encoded (AES-256-GCM)
# APP_SECRET_KEY: random string for session signing (min 32 chars)
APP_ENCRYPTION_KEY=
APP_SECRET_KEY=

# CORS — comma-separated origins; empty = no cross-origin browser access
CORS_ORIGINS=

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=INFO

# Scheduler — only enable on a single worker process
SCHEDULER_ENABLED=true
SCHEDULER_LOCK_KEY=portfolio_scheduler_lock

# Auth / sessions
SESSION_COOKIE_NAME=portfolio_session
SESSION_MAX_AGE_SECONDS=86400
REFRESH_TOKEN_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT=10/minute

# Bootstrap admin (optional one-time; leave empty after first user)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Request limits
MAX_REQUEST_BODY_BYTES=1048576
